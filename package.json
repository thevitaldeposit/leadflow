{
  "name": "leadflow",
  "version": "1.0.0",
  "description": "AI-powered CRM lead extraction for automotive dealerships",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node server/index.js",
    "build": "cd client && npm install && npm run build",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server/index.js",
    "client": "cd client && npm run dev",
    "setup": "npm install && cd client && npm install && cd .. && node server/db/migrations.js",
    "init-db": "node server/db/migrations.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "form-data": "^4.0.5",
    "multer": "^1.4.5-lts.1",
    "openai": "^6.39.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
