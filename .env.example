ANTHROPIC_API_KEY=your_anthropic_api_key_here
PORT=3001
DATABASE_PATH=./server/db/leadflow.db

# Transcription (at least one required for audio features)
OPENAI_API_KEY=your_openai_api_key_here
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Transcription provider preference: openai or deepgram (openai is default)
TRANSCRIPTION_PROVIDER=openai

# Twilio Integration (only needed for automatic call capture)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here
USER_PHONE_NUMBER=your_personal_phone_number_to_forward_calls_to

# ── Twilio Voice (iOS incoming-call client) ─────────────────────────────────
# Used ONLY by POST /api/voice/token, which mints a Twilio Voice access token so
# the iOS app can register for VoIP push and ring natively. These FOUR SIDs do
# not exist yet — they can only be created AFTER the Apple Developer account is
# active and a VoIP Services certificate has been generated. Until all four are
# set, /api/voice/token returns HTTP 503 ("Voice not yet configured") and the
# rest of the backend (including the existing call-capture pipeline) is
# unaffected. Set these locally for testing AND in the Railway environment.
#
# How to obtain each (Twilio Console — no code changes, console only):
#  1. TWILIO_API_KEY / TWILIO_API_SECRET — Console → Account → API keys & tokens
#     → "Create API key" (Standard). Copy the SID (SKxxxx) into TWILIO_API_KEY
#     and the Secret (shown ONCE) into TWILIO_API_SECRET.
#  2. TWILIO_VOICE_PUSH_CREDENTIAL_SID — Console → Voice → Manage → Push
#     Credentials → "Create new Credential", type VoIP, and upload the Apple
#     VoIP Services certificate (.p12 / cert + key) from the Apple Developer
#     account. Copy the resulting Credential SID (CRxxxx).
#  3. TWILIO_TWIML_APP_SID — Console → Voice → Manage → TwiML Apps → "Create new
#     TwiML App". (Its Voice Request URL is for OUTGOING calls and can be filled
#     in later; it is not required for receiving calls.) Copy the App SID (APxxxx).
TWILIO_API_KEY=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_SECRET=your_twilio_api_secret_here
TWILIO_TWIML_APP_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_VOICE_PUSH_CREDENTIAL_SID=CRxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Stripe subscription billing ($149/mo Stream plan). All three are REQUIRED for
# billing to work.
STRIPE_SECRET_KEY=sk_live_or_test_secret_key_here
STRIPE_PRICE_ID=price_id_of_the_149_monthly_plan
# STRIPE_WEBHOOK_SECRET — the signing secret for the /api/webhook/stripe endpoint.
# Get it from the Stripe Dashboard → Developers → Webhooks → (your endpoint) →
# "Signing secret" (starts with whsec_). Add the endpoint pointing at
# https://<your-host>/api/webhook/stripe and subscribe to: checkout.session.completed,
# customer.subscription.updated, customer.subscription.deleted, invoice.payment_failed.
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here
