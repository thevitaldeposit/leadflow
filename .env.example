ANTHROPIC_API_KEY=your_anthropic_api_key_here
PORT=3001
DATABASE_PATH=./server/db/leadflow.db

# Transcription (at least one required for audio features)
OPENAI_API_KEY=your_openai_api_key_here
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Transcription provider preference: openai or deepgram (openai is default)
TRANSCRIPTION_PROVIDER=openai

# Twilio Integration (only needed for automatic call capture)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here
USER_PHONE_NUMBER=your_personal_phone_number_to_forward_calls_to
